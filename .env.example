# ORCA Environment Configuration
APP_NAME=ORCA
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Security & Secret Management
SECRET_KEY=orca-secret-key-change-in-production-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Data Engine & Provider Configuration
DEMO_MODE=true
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1

# AI & LLM Provider (Optional - fallback parser works offline)
GEMINI_API_KEY=

# Database Configuration (SQLite default for dev, Cloud SQL / PostgreSQL compatible)
DATABASE_URL=sqlite:///./orca.db

# Monitoring Engine Configuration
MONITORING_INTERVAL_MINUTES=5
WAVE_CHANGE_THRESHOLD_M=0.5
WIND_CHANGE_THRESHOLD_KMH=10.0
SAFETY_SCORE_CHANGE_THRESHOLD=10.0

# Decision Engine Threshold Weights
WEIGHT_SAFETY=0.50
WEIGHT_FISHING=0.30
WEIGHT_TRAVEL=0.20
